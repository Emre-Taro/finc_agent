# このファイルはGitHubにコミットされる見本です。本物のキーやパスワードは書かず、
# このファイルを .env にコピーして、そちらに記入してください（.env はコミットされません）。
ANTHROPIC_API_KEY=sk-ant-...
# 精度を上げたい場合は claude-sonnet-5-5 や claude-opus-5-5 に変更
CLAUDE_MODEL=claude-haiku-5-5

# ローカル:  postgresql://postgres:password@127.0.0.1:5432/finc_agent
# Neon 等:   postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/finc_agent
# https://fred.stlouisfed.org/docs/api/api_key.html で無料発行
FRED_API_KEY=

ANALYSIS_CONCURRENCY=4
NEWS_LOOKBACK_HOURS=48
MAX_ITEMS_PER_FEED=25
CORS_ORIGINS=http://localhost:3000
